# Salin ke .env  ->  jalankan "npm run setup" agar secret dibuat acak otomatis.
# Nilai CHANGE_ME akan ditolak oleh aplikasi.

# Port
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

# URL antar-komponen (gunakan 127.0.0.1, bukan localhost, agar tidak terkena masalah IPv6)
GATEWAY_URL=http://127.0.0.1:3000
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002

# Database SQLite bersama
DB_PATH=./data/zero-trust.db

# Secret (min. 16 karakter)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
GATEWAY_SECRET=CHANGE_ME

# Kredensial Service Nilai untuk POST /auth/service
SERVICE_NILAI_CLIENT_ID=service-nilai
SERVICE_NILAI_CLIENT_SECRET=CHANGE_ME

# Masa berlaku token (format jsonwebtoken: 10m, 1d, ...)
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=1d
SERVICE_TOKEN_TTL=5m

# Jam akses edit/finalisasi nilai (HH:MM, zona waktu di bawah). 24:00 = akhir hari.
TIMEZONE=Asia/Jakarta
ACCESS_START=07:00
ACCESS_END=21:00
